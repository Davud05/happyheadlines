@startuml container
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()

title Happy Headlines - Containers (C4 level 2)

Person(publisher, "Publisher", "Writes and publishes articles.")
Person(reader, "Reader", "Reads, comments and subscribes.")

System_Boundary(hh, "Happy Headlines") {
    Container(webapp, "Webapp", "ASP.NET Core Razor Pages", "Where publishers write drafts and publish articles.")
    Container(website, "Website", "ASP.NET Core Razor Pages", "Shows the most recent articles with one focus article on top.")

    Container(draftService, "DraftService", "ASP.NET Core REST API", "Saves and retrieves drafts of articles.")
    ContainerDb(draftDb, "DraftDatabase", "PostgreSQL", "Stores all drafts of articles.")

    Container(publisherService, "PublisherService", "ASP.NET Core REST API", "Finalises and publishes articles.")
    Container(profanityService, "ProfanityService", "ASP.NET Core REST API", "Filters out inappropriate language in articles and comments.")
    ContainerDb(profanityDb, "ProfanityDatabase", "PostgreSQL", "Stores all prohibited words.")

    ContainerQueue(articleQueue, "ArticleQueue", "RabbitMQ", "Holds newly published articles.")
    Container(articleService, "ArticleService", "ASP.NET Core REST API", "Delivers published articles to the subsystems that request them.")
    ContainerDb(articleDb, "ArticleDatabase", "PostgreSQL", "Stores all published articles.")
    ContainerDb(articleCache, "ArticleCache", "Redis", "Offline cache containing articles from the latest 14 days.")

    Container(commentService, "CommentService", "ASP.NET Core REST API", "Handles comments on articles.")
    ContainerDb(commentDb, "CommentDatabase", "PostgreSQL", "Stores all comments posted on articles.")
    ContainerDb(commentCache, "CommentCache", "Redis", "Recent comments filled on cache miss, cleaned with an LRU algorithm.")

    Container(subscriberService, "SubscriberService", "ASP.NET Core REST API", "Handles newsletter subscriptions. Hidden behind the SUBSCRIBER_SERVICE release toggle.")
    ContainerDb(subscriberDb, "SubscriberDatabase", "PostgreSQL", "Stores subscriber information.")
    ContainerQueue(subscriberQueue, "SubscriberQueue", "RabbitMQ", "Holds subscribe and unsubscribe events.")

    Container(newsletterService, "NewsletterService", "ASP.NET Core REST API", "Composes and sends newsletters to subscribers.")
    ContainerDb(newsletterDb, "NewsletterDatabase", "PostgreSQL", "NewsletterService's own copy of the subscribers, built from SubscriberQueue.")

    Container(featureHub, "FeatureHub", "FeatureHub Party Server", "Release toggles, streamed to the services and changed at runtime.")
    ContainerDb(featureHubDb, "FeatureHubDatabase", "PostgreSQL", "Stores feature toggles and their values.")
}

Rel(publisher, webapp, "Writes and publishes articles using")
Rel(reader, website, "Reads articles, comments and subscribes using")

Rel(webapp, draftService, "Saves and fetches drafts", "HTTP/JSON")
Rel(draftService, draftDb, "Stores and retrieves drafts")

Rel(webapp, publisherService, "Publishes an article", "HTTP/JSON")
Rel(publisherService, profanityService, "Filters profanity in article", "HTTP/JSON")
Rel(publisherService, articleQueue, "Places approved article in")

Rel(profanityService, profanityDb, "Retrieves and removes prohibited words")

Rel(articleService, articleQueue, "Subscribes to new articles from")
Rel(articleService, articleDb, "Stores and fetches articles")
Rel(articleService, articleCache, "Finds articles in the cache before contacting the database")

Rel(website, articleService, "Fetches articles", "HTTP/JSON")
Rel(website, commentService, "Posts and fetches comments", "HTTP/JSON")
Rel(website, subscriberService, "Sends subscription requests", "HTTP/JSON")

Rel(commentService, profanityService, "Filters profanity in comment", "HTTP/JSON")
Rel(commentService, commentDb, "Stores and fetches comments")
Rel(commentService, commentCache, "Finds comments in the cache before contacting the database")

Rel(subscriberService, subscriberDb, "Stores subscriber information")
Rel(subscriberService, subscriberQueue, "Places subscribe and unsubscribe events in")

Rel(newsletterService, subscriberQueue, "Consumes subscriber events from")
Rel(newsletterService, newsletterDb, "Stores and reads its copy of the subscribers")
Rel(newsletterService, articleQueue, "Subscribes to latest news for immediate newsletter")
Rel(newsletterService, articleService, "Requests articles for daily newsletter", "HTTP/JSON")
Rel(newsletterService, reader, "Sends newsletter to", "Email")

Rel(subscriberService, featureHub, "Reads release toggle", "SSE")
Rel(newsletterService, featureHub, "Reads release toggle", "SSE")
Rel(website, featureHub, "Reads release toggle", "SSE")
Rel(featureHub, featureHubDb, "Stores toggles")

SHOW_LEGEND()
@enduml
