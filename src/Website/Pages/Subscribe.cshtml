@page
@model SubscribeModel
@{
    ViewData["Title"] = "Newsletter";
}

<section style="max-width: 32rem">
    <h1 class="h3">Get good news in your inbox</h1>
    <p class="text-muted">Breaking good news as it is published, plus a daily digest every morning.</p>

    @if (Model.Message is not null)
    {
        <div class="alert @(Model.Succeeded ? "alert-success" : "alert-warning")">@Model.Message</div>
    }

    <form method="post">
        <div class="mb-2">
            <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button class="btn btn-primary">Subscribe</button>
    </form>
</section>
