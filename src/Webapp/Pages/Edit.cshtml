@page
@model EditModel
@{
    ViewData["Title"] = Model.Id is null ? "New draft" : "Edit draft";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="mt-3" style="max-width: 48rem">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Author" class="form-label"></label>
        <input asp-for="Author" class="form-control" />
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Continent" class="form-label">Region</label>
        <select asp-for="Continent" asp-items="@(new SelectList(Model.AllContinents))" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" rows="12" class="form-control"></textarea>
    </div>
    <button class="btn btn-primary">Save draft</button>
    <a class="btn btn-link" asp-page="/Index">Cancel</a>
</form>
